# Copie para .env (cp .env.example .env). O .env não é versionado.

# --- PostgreSQL (lidos pelo docker compose) ---
POSTGRES_USER=postgres
# Use só letras, números e "_": a senha vai dentro da URL de conexão.
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=anticipation

# --- Aplicação ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Exposição da API (opcional) ---
# Padrão: só localhost:8000. Em servidor (ex.: AWS) o deploy define API_BIND=0.0.0.0 e API_PORT=80.
# API_BIND=127.0.0.1
# API_PORT=8000
