    {
      "name": "2. Fluxo feliz (aprovado)",
      "item": [
        {
          "name": "POST /titulos (valor pequeno)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "function iso(d) { return d.toISOString().slice(0, 10); }",
                  "var hoje = new Date();",
                  "pm.variables.set('vencimento', iso(new Date(hoje.getTime() + 30 * 86400000)));",
                  "pm.variables.set('vencimentoLongo', iso(new Date(hoje.getTime() + 400 * 86400000)));",
                  "pm.variables.set('vencimentoPassado', iso(new Date(hoje.getTime() - 86400000)));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', function () { pm.response.to.have.status(202); });",
                  "var corpo = pm.response.json();",
                  "pm.test('status PENDENTE e id UUID', function () { pm.expect(corpo.status).to.eql('PENDENTE'); pm.expect(corpo.id).to.match(/^[0-9a-f-]{36}$/); });",
                  "pm.test('Location aponta para o titulo', function () { pm.expect(pm.response.headers.get('Location')).to.eql('/titulos/' + corpo.id); });",
                  "pm.collectionVariables.set('tituloAprovadoId', corpo.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/titulos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "titulos"
              ]
            },
            "description": "Responde 202 na hora, sem esperar a analise. O id fica salvo em {{tituloAprovadoId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cnpj_sacado\": \"11.222.333/0001-81\",\n  \"valor_titulo\": \"1500.50\",\n  \"data_vencimento\": \"{{vencimento}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "GET /titulos/{id} (imediato = PENDENTE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', function () { pm.response.to.have.status(200); });",
                  "pm.test('ainda PENDENTE (analise leva ~5s)', function () { pm.expect(pm.response.json().status).to.eql('PENDENTE'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/titulos/{{tituloAprovadoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "titulos",
                "{{tituloAprovadoId}}"
              ]
            },
            "description": "Consulta logo apos o POST: a analise em background ainda nao terminou."
          },
          "response": []
        },
        {
          "name": "GET /titulos/{id} (apos 7s = APROVADO)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "setTimeout(function () {}, 7000);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var t = pm.response.json();",
                  "pm.test('200', function () { pm.response.to.have.status(200); });",
                  "pm.test('APROVADO', function () { pm.expect(t.status).to.eql('APROVADO'); });",
                  "pm.test('CNPJ normalizado e valor como string', function () { pm.expect(t.cnpj_sacado).to.eql('11222333000181'); pm.expect(t.valor_titulo).to.eql('1500.50'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/titulos/{{tituloAprovadoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "titulos",
                "{{tituloAprovadoId}}"
              ]
            },
            "description": "Aguarda 7 segundos antes de enviar (script de pre-request) e confere a decisao do worker."
          },
          "response": []
        }
      ]
